# MongoDB Connection String
# Local:  mongodb://localhost:27017/verde
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/verde
MONGO_URI=mongodb://localhost:27017/verde

# JWT Secret — change this to a long random string in production
JWT_SECRET=verde_super_secret_key_change_me

# JWT Expiry
JWT_EXPIRES_IN=7d

# Server Port & Public Host URL
PORT=5000
SERVER_URL=https://your-online-api-domain.com

# Frontend Client URL
CLIENT_URL=http://localhost:3000
